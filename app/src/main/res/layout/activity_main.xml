<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:paddingBottom="16dp"
            android:text="Status: idle" />

        <Button
            android:id="@+id/openAccessibilitySettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Open Accessibility Settings (grant permission)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text="Batch size (messages selected before each delete):" />
        <EditText
            android:id="@+id/batchSizeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="1000" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Session cap (stop automatically after deleting this many total -- keep this LOW until you've verified behavior):" />
        <EditText
            android:id="@+id/sessionCapInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="1000" />

        <CheckBox
            android:id="@+id/dryRunCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:checked="true"
            android:text="Dry run (log actions, never actually tap/delete)" />

        <CheckBox
            android:id="@+id/autoContinueCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="Auto-continue past session cap (uncheck = stop and wait after each cap)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:textStyle="bold"
            android:text="Before starting: open Google Messages, open the long thread, manually scroll to just past the point where you want deletion to stop (the newest message you want DELETED should be near the top of the visible screen). The service works upward from wherever the thread is scrolled to when you hit Start." />

        <Button
            android:id="@+id/dumpTreeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="2. Dump current screen tree to Logcat (debug/tuning)" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="3. Start" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Stop" />

    </LinearLayout>
</ScrollView>
